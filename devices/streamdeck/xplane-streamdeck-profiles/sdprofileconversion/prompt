    file-names:
      - cws.0.0 #settingsModel.OffImage
      - cws.1.0 #settingsModel.OnImage
    dataref: laminar/B738/autopilot/cws_a_status #settingsModel.Address
    dataref-states: #settingsModel.AddressAction
      - 0.0 #settingsModel.OffState
      - 1.0 #settingsModel.OnState
    command: laminar/B738/autopilot/cws_a_press
    label: CWS-A #States.Title

