#Case 7: Value Display (formatted dataref value output)

  - index: 2
    name: wind_speed_knots
    type: none
    dataref: sim/weather/aircraft/wind_speed_kts[0] #sim/cockpit2/gauges/indicators/wind_speed_kts
    display:
      name: display_wind_speed_knots
      text-center:
        x: center
        y: 70 # center doesn't work as it should, due to font's height
      font-path: IBMPlexMono-Bold.ttf
      font-size: 20
      zero-pad: False
      min: 0
      max: 100
      step: 1
      color: lime
      keep-decimal: False
      background: none