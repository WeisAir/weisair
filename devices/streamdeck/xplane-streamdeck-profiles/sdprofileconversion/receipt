#Case 1: Push Button with static icon
  - index: 26
    name: flashlight
    type: single
    icon: flashlight
    command: sim/view/flashlight_wht
    label: FLASHLIGHT


#Case 2: Toggle Button with dynamic icon (Multiple states)
  - index: 20
    name: position lights
    type: single
    file-names:
      - strobe_lgt_strobesteady
      - strobe_lgt_off
      - strobe_lgt_steady
    dataref: laminar/B738/toggle_switch/position_light_pos
    dataref-states:
      - -1.0
      - 0.0
      - 1.0
    command: WeisAIR/b738/LIGHTS/b738_pos_lights_toggle
    label: POSITION LIGHTS


#Case 3: ON/OFF Button with dynamic icon (separate ON/OFF Commands)  

  - index: 8
    name: battery
    type: dual
    file-names:
      - switch_off
      - switch_on
    dataref: laminar/B738/electric/battery_pos
    dataref-states:
      - 0.0
      - 1.0
    command-on: laminar/B738/switch/battery_dn
    command-off: laminar/B738/switch/battery_up
    label: BATTERY

